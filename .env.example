# Copiez ce fichier vers `.env` en local. Ne commitez jamais les secrets.

PORT=4319
APP_URL=http://localhost:5173
SESSION_SECRET=changez-moi-en-production

# Identifiants historiques du scraper / SQLite (ne pas renommer : déjà en production).
# WEGEO_DB=data/wegeo.db
# WEGEO_BROWSER_DIR=data/browser
# WEGEO_HEADFUL=0
# WEGEO_DEBUG=0
# WEGEO_NO_SANDBOX=0

# Stripe — la clé secrète et le secret webhook restent côté serveur.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCE=price_...
# Libellés d’affichage (centimes d’euro). Le montant facturé est celui de Stripe.
# PLAN_STARTER_CENTS=2900
# PLAN_PRO_CENTS=7900
# PLAN_AGENCE_CENTS=14900

# Google OAuth — connexion + export Sheets.
# URI de redirection : {APP_URL}/api/auth/google/callback
# Scopes : openid, email, profile, https://www.googleapis.com/auth/spreadsheets
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# E-mail des codes (vérification, connexion, mot de passe oublié).
# Resend, ou SMTP. En local sans clé, le code s’affiche dans le terminal API.
# MAIL_FROM=Prospy <noreply@votre-domaine.fr>
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
