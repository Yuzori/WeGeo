# Copiez ce fichier vers `.env` en local. Ne commitez jamais les secrets.

PORT=4319
APP_URL=http://localhost:5173
SESSION_SECRET=changez-moi-en-production

# Identifiants historiques du scraper / SQLite (ne pas renommer : déjà en production).
# WEGEO_DB=data/wegeo.db
# WEGEO_BROWSER_DIR=data/browser
# WEGEO_HEADFUL=0
# WEGEO_DEBUG=0
# WEGEO_NO_SANDBOX=0
# Parallélisme du relevé (plafond 16). Défauts : 4 métiers, 10 fiches en même temps.
# WEGEO_TASK_CONCURRENCY=4
# WEGEO_DETAIL_CONCURRENCY=10

# Stripe — la clé secrète et le secret webhook restent côté serveur.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCE=price_...
# Libellés d’affichage (centimes d’euro). Le montant facturé sera celui de Stripe.
# PLAN_STARTER_CENTS=1900
# PLAN_PRO_CENTS=4900
# PLAN_AGENCE_CENTS=8900

# Google OAuth — connexion + export Sheets.
# 1. Console Google Cloud → API et services → Identifiants → ID client OAuth (application Web)
# 2. URI de redirection autorisée (obligatoire, tel quel) :
#    {APP_URL}/api/auth/google/callback
#    En local : http://localhost:5173/api/auth/google/callback
# 3. Activez l’API Google Sheets
# 4. Écran de consentement : scopes e-mail, profil, spreadsheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (codes d’inscription, mot de passe oublié, invitations de session).
# Resend : https://resend.com — MAIL_FROM doit être un domaine vérifié.
# Ou SMTP (Gmail : mot de passe d’application, port 465 ou 587).
MAIL_FROM=Prospy <noreply@votre-domaine.fr>
RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
